                  "items": {
                    "type": "string",
                    "enum": [
                      "anxiete",
                      "impuissance",
                      "colere",
                      "tristesse",
                      "peur",
                      "culpabilite"
                    ],
                    "description": "Localisation émotionnelle. Caractéristique associée : anxiété CHA, impuissance CHA, colère LOG, tristesse PER, peur VOL, culpabilité DEX.",
                    "examples": [
                      "peur",
                      "colere"
                    ]
                  },
                  "description": "Localisations émotionnelles couvertes par le trait de caractère. Au moins une, pour la même raison que l'armure.",
                  "examples": [
                    [
                      "peur",
                      "anxiete"
                    ]
                  ]
                }
              },
              "required": [
                "trait",
                "points",
                "localisations"
              ],
              "additionalProperties": false
            },
            "bouclier": {
              "description": "Bouclier mental : la censure derrière laquelle le personnage se réfugie.",
