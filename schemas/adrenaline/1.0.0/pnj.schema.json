    "protections": {
      "description": "Protections, chaque versant facultatif : une fiche peut ne chiffrer que le physique.",
      "type": "object",
      "properties": {
        "physiques": {
          "type": "object",
          "properties": {
            "solidite": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "PP de Solidité physique. Fixe le seuil superficiel.",
              "examples": [
                7
              ]
            },
            "armure": {
              "description": "Armure portée, si le personnage en a une.",
              "type": "object",
              "properties": {
                "nom": {
                  "description": "Nom de l'armure, tel qu'écrit sur la fiche.",
                  "examples": [
                    "Blouson de cuir"
                  ],
                  "type": "string",
                  "minLength": 1
                },
                "points": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "PP d'Armure. S'ajoutent à la base de chaque seuil sur les localisations couvertes.",
                  "examples": [
                    2
                  ]
                },
                "localisations": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "jambe-droite",
                      "jambe-gauche",
                      "torse",
                      "bras-faible",
                      "bras-fort",
                      "tete"
                    ],
                    "description": "Localisation corporelle. Caractéristique associée : jambe droite RAP, jambe gauche RAP, torse ou dos CON, bras faible DEX, bras fort FOR, tête PER.",
                    "examples": [
                      "torse",
                      "tete"
                    ]
                  },
                  "description": "Localisations corporelles couvertes par l'armure. Au moins une : une armure ne couvrant rien rendrait la valeur couverte de chaque seuil ininterprétable.",
                  "examples": [
                    [
                      "torse",
                      "bras-fort"
                    ]
                  ]
                }
              },
              "required": [
                "points",
                "localisations"
              ],
              "additionalProperties": false
            },
            "bouclier": {
              "description": "Bouclier physique : ce que le personnage interpose entre lui et le coup.",
              "type": "object",
              "properties": {
                "nom": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Nom du bouclier, tel qu'écrit sur la fiche.",
                  "examples": [
                    "Portière de voiture",
                    "Déni"
                  ]
                },
                "proprietes": {
                  "description": "Type de couvert (bouclier physique) ou de censure (bouclier mental).",
                  "examples": [
                    [
                      "Couvert partiel"
                    ]
                  ],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Une propriété, en un mot ou deux."
                  }
                }
              },
              "required": [
                "nom"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "solidite"
          ],
          "additionalProperties": false,
          "description": "Protections physiques : solidité, armure, bouclier."
        },
        "mentales": {
          "type": "object",
          "properties": {
            "solidite": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "PM de Solidité mentale. Fixe le seuil mental superficiel.",
              "examples": [
                5
              ]
            },
            "caractere": {
              "description": "Trait de caractère protecteur, si le personnage en a un.",
              "type": "object",
              "properties": {
                "trait": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Trait de caractère qui protège. Chaîne libre : le catalogue est éditorial.",
                  "examples": [
