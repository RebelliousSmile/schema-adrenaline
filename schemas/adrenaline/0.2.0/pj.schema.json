              ],
              "additionalProperties": false
            }
          },
          "required": [
            "solidite"
          ],
          "additionalProperties": false,
          "description": "Protections mentales : solidité, trait de caractère, bouclier."
        }
      },
      "required": [
        "physiques",
        "mentales"
      ],
      "additionalProperties": false,
      "description": "Les deux versants de la protection. Symétriques par construction : le socle traite le conflit mental comme le conflit physique."
    },
    "formations": {
      "description": "Formations du personnage. La feuille en imprime trois colonnes — classe sociale, professionnelle, personnelle — mais la liste n'est pas bornée : d'autres s'acquièrent en campagne.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "description": "Type de formation, imprimé en tête de colonne sur la feuille de PJ. Absent d'une fiche de PNJ, qui ne qualifie pas ses formations.",
            "type": "string",
            "enum": [
              "classe-sociale",
              "professionnelle",
              "personnelle"
            ],
            "examples": [
              "professionnelle"
            ]
          },
          "nom": {
            "type": "string",
            "minLength": 1,
            "description": "Nom de la formation, écrit à la main entre parenthèses sur la feuille.",
            "examples": [
              "Moyenne",
              "Infirmière"
            ]
          },
          "pourcentage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200,
            "description": "Pourcentage de la formation.",
            "examples": [
              15,
              40
            ]
          },
          "competences": {
            "description": "Compétences rattachées à cette formation. La feuille de PJ les imprime sous la colonne de leur formation ; la fiche de PNJ les regroupe hors formation, et cette liste est alors absente.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nom": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Nom de la compétence. Chaîne libre : le catalogue appartient à chaque jeu.",
                  "examples": [
                    "Arme sociale",
                    "Athlétisme"
                  ]
                },
                "specialite": {
                  "description": "Spécialité, notée entre parenthèses après le nom sur la fiche.",
                  "examples": [
                    "Négociation"
                  ],
                  "type": "string",
                  "minLength": 1
                },
                "pourcentage": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200,
                  "description": "Pourcentage de la compétence seule, hors caractéristique.",
                  "examples": [
                    30
                  ]
                },
                "caracteristique": {
                  "description": "Caractéristique qui s'ajoute au pourcentage. Notée sur la fiche de PNJ, laissée au jet sur la feuille de PJ.",
                  "examples": [
                    "cha"
                  ],
                  "type": "string",
                  "enum": [
                    "for",
                    "con",
                    "dex",
                    "rap",
                    "log",
                    "vol",
                    "per",
                    "cha"
                  ]
                },
                "total": {
                  "description": "Pourcentage testé, compétence plus caractéristique. Pré-calculé sur la fiche de PNJ ; se recalcule à tout instant. Le schéma ne vérifie pas la somme — la caractéristique vit dans un autre bloc et draft-7 ne sait pas exprimer cette dépendance : un consommateur doit recalculer la valeur plutôt que la croire.",
                  "examples": [
                    50
                  ],
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "avantages": {
                  "description": "Avantages rattachés à cette compétence, notés sous elle sur la fiche : gestion du stress, bouclier personnel, équipement favori.",
                  "examples": [
                    [
                      "Gestion du stress"
                    ]
                  ],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Un avantage, en une ligne."
                  }
                }
              },
              "required": [
                "nom",
                "pourcentage"
              ],
              "additionalProperties": false,
              "description": "Une compétence de la fiche, avec sa spécialité et son total éventuel."
            }
          }
        },
        "required": [
          "nom",
          "pourcentage"
        ],
        "additionalProperties": false,
        "description": "Une formation et les compétences qu'elle porte."
      }
    },
    "equipement": {
      "description": "Bloc Équipement de la feuille.",
      "type": "object",
      "properties": {
        "possessions": {
          "description": "Ce que le personnage transporte ou possède. Liste non bornée.",
          "examples": [
            [
              "Trousse de secours",
              "Lampe torche"
            ]
          ],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Un objet possédé, en une ligne."
          }
        },
        "equipementFavori": {
          "description": "L'équipement favori, au singulier : la feuille n'en prévoit qu'un, et il ouvre un avantage.",
          "examples": [
            "Trousse de secours"
          ],
          "type": "string",
          "minLength": 1
        },
        "armesPhysiques": {
          "description": "Armes physiques. Liste non bornée : les deux lignes de la feuille sont de la place sur le papier, pas une règle.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nom": {
                "type": "string",
                "minLength": 1,
                "description": "Nom de l'arme, tel qu'écrit sur la feuille. Chaîne libre.",
                "examples": [
                  "Judo",
                  "Batte de baseball",
                  "Sarcasme"
                ]
              },
              "pourcentage": {
                "description": "Pourcentage auquel l'arme se manie, tel que noté sur la feuille.",
                "examples": [
                  30
                ],
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              },
              "desDeDegats": {
                "description": "Nombre de d10 de dégâts.",
                "examples": [
                  1,
                  2
                ],
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "type": {
                "description": "Contact ou distance pour une arme physique, psychologique ou sociale pour une arme mentale.",
                "examples": [
                  "Contact",
                  "Sociale"
                ],
                "type": "string",
                "minLength": 1
