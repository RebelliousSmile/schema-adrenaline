{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "minLength": 1,
      "description": "Nom du personnage, en en-tête de la feuille.",
      "examples": [
        "Claire Vasseur"
      ]
    },
    "identite": {
      "description": "Bloc Identité de la feuille. Facultatif : le livre le laisse libre au joueur.",
      "type": "object",
      "properties": {
        "nationalite": {
          "description": "Nationalité, en clair.",
          "examples": [
            "Française"
          ],
          "type": "string",
          "minLength": 1
        },
        "genre": {
          "description": "Genre, en clair. Chaîne libre : la feuille n'impose aucune liste.",
          "examples": [
            "Femme"
          ],
          "type": "string",
          "minLength": 1
        },
        "cheveux": {
          "description": "Couleur ou aspect des cheveux.",
          "examples": [
            "Bruns, coupés court"
          ],
          "type": "string",
          "minLength": 1
        },
        "age": {
          "description": "Âge en années.",
          "examples": [
            34
          ],
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "yeux": {
          "description": "Couleur des yeux.",
          "examples": [
            "Verts"
          ],
          "type": "string",
          "minLength": 1
        },
        "taille": {
          "description": "Taille, telle qu'écrite sur la feuille, unité comprise. Chaîne libre et non un nombre : la feuille est manuscrite et n'impose pas d'unité, deux fiches ne sont donc pas comparables sur ce champ.",
          "examples": [
            "1,72 m"
          ],
          "type": "string",
          "minLength": 1
        },
        "peau": {
          "description": "Teint ou aspect de la peau.",
          "examples": [
            "Mate"
          ],
          "type": "string",
          "minLength": 1
        },
        "poids": {
          "description": "Poids, tel qu'écrit sur la feuille, unité comprise. Même réserve que la taille : chaîne libre, non comparable d'une fiche à l'autre.",
          "examples": [
            "64 kg"
          ],
          "type": "string",
          "minLength": 1
        },
        "signesParticuliers": {
          "description": "Signes particuliers : cicatrices, tatouages, tout ce qui se remarque.",
          "examples": [
            [
              "Cicatrice à l'arcade gauche"
            ]
          ],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Un signe particulier, en une ligne."
          }
        }
      },
      "additionalProperties": false
    },
    "caracteristiques": {
      "type": "object",
      "properties": {
        "for": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Force. Pourcentage de d100.",
          "examples": [
            40
          ]
        },
        "con": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Constitution. Pourcentage de d100.",
          "examples": [
            50
          ]
        },
        "dex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Dextérité. Pourcentage de d100.",
          "examples": [
            45
          ]
        },
        "rap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Rapidité. Pourcentage de d100.",
          "examples": [
            35
          ]
        },
        "log": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Logique. Pourcentage de d100.",
          "examples": [
            30
          ]
        },
        "vol": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Volonté. Pourcentage de d100.",
          "examples": [
            40
          ]
        },
        "per": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Perception. Pourcentage de d100.",
          "examples": [
            50
          ]
        },
        "cha": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Charisme. Pourcentage de d100.",
          "examples": [
            25
          ]
        }
      },
      "required": [
        "for",
        "con",
        "dex",
        "rap",
        "log",
        "vol",
        "per",
        "cha"
      ],
      "additionalProperties": false,
      "description": "Les huit caractéristiques. La qualité — le chiffre des dizaines — se recalcule et n'est pas stockée ; la colonne « Actuel » de la feuille relève de l'état de partie."
    },
    "sante": {
      "type": "object",
