    "actionsParRound": {
      "description": "Nombre d'actions par round.",
      "examples": [
        1
      ],
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "etatAlternatif": {
      "description": "État second de la créature, quand elle en a un.",
      "type": "object",
      "properties": {
        "nom": {
          "type": "string",
          "minLength": 1,
          "description": "Nom de l'état, par exemple stimulé.",
          "examples": [
            "Stimulé"
