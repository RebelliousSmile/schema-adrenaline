                  ]
                },
                "couvert": {
                  "description": "Valeur du seuil sur une localisation couverte par une armure ou un trait de caractère. Vaut la base augmentée des points de protection.",
                  "examples": [
                    9,
                    18
                  ],
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "base"
              ],
              "additionalProperties": false,
              "description": "Seuil de dégât léger."
            },
            "grave": {
              "type": "object",
              "properties": {
                "base": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Valeur du seuil sur une localisation non couverte.",
                  "examples": [
                    7,
                    16
                  ]
                },
                "couvert": {
                  "description": "Valeur du seuil sur une localisation couverte par une armure ou un trait de caractère. Vaut la base augmentée des points de protection.",
                  "examples": [
                    9,
                    18
                  ],
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "base"
              ],
              "additionalProperties": false,
              "description": "Seuil de dégât grave."
            },
            "profond": {
              "type": "object",
              "properties": {
                "base": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Valeur du seuil sur une localisation non couverte.",
                  "examples": [
                    7,
                    16
                  ]
                },
                "couvert": {
                  "description": "Valeur du seuil sur une localisation couverte par une armure ou un trait de caractère. Vaut la base augmentée des points de protection.",
                  "examples": [
                    9,
                    18
                  ],
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "base"
              ],
              "additionalProperties": false,
              "description": "Seuil de dégât profond, le plus élevé des quatre."
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "physique"
      ],
      "additionalProperties": false
    },
    "protections": {
      "description": "Protections, chaque versant facultatif.",
      "type": "object",
      "properties": {
        "physiques": {
          "type": "object",
          "properties": {
            "solidite": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "PP de Solidité physique. Fixe le seuil superficiel.",
              "examples": [
                7
              ]
            },
            "armure": {
              "description": "Armure portée, si le personnage en a une.",
              "type": "object",
              "properties": {
                "nom": {
                  "description": "Nom de l'armure, tel qu'écrit sur la fiche.",
                  "examples": [
                    "Blouson de cuir"
                  ],
                  "type": "string",
                  "minLength": 1
                },
                "points": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "PP d'Armure. S'ajoutent à la base de chaque seuil sur les localisations couvertes.",
                  "examples": [
                    2
                  ]
                },
                "localisations": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "jambe-droite",
                      "jambe-gauche",
                      "torse",
                      "bras-faible",
                      "bras-fort",
                      "tete"
                    ],
                    "description": "Localisation corporelle. Caractéristique associée : jambe droite RAP, jambe gauche RAP, torse ou dos CON, bras faible DEX, bras fort FOR, tête PER.",
                    "examples": [
                      "torse",
                      "tete"
                    ]
                  },
                  "description": "Localisations corporelles couvertes par l'armure. Au moins une : une armure ne couvrant rien rendrait la valeur couverte de chaque seuil ininterprétable.",
                  "examples": [
                    [
                      "torse",
                      "bras-fort"
                    ]
                  ]
                }
              },
              "required": [
                "points",
                "localisations"
              ],
              "additionalProperties": false
            },
            "bouclier": {
              "description": "Bouclier physique : ce que le personnage interpose entre lui et le coup.",
              "type": "object",
              "properties": {
                "nom": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Nom du bouclier, tel qu'écrit sur la fiche.",
                  "examples": [
                    "Portière de voiture",
                    "Déni"
                  ]
                },
                "proprietes": {
                  "description": "Type de couvert (bouclier physique) ou de censure (bouclier mental).",
                  "examples": [
                    [
                      "Couvert partiel"
                    ]
                  ],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Une propriété, en un mot ou deux."
                  }
                }
              },
              "required": [
                "nom"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "solidite"
          ],
          "additionalProperties": false,
          "description": "Protections physiques : solidité, armure, bouclier."
        },
        "mentales": {
          "type": "object",
          "properties": {
            "solidite": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "PM de Solidité mentale. Fixe le seuil mental superficiel.",
              "examples": [
                5
              ]
            },
            "caractere": {
              "description": "Trait de caractère protecteur, si le personnage en a un.",
              "type": "object",
              "properties": {
                "trait": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Trait de caractère qui protège. Chaîne libre : le catalogue est éditorial.",
                  "examples": [
                    "Cynique"
                  ]
                },
                "points": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "PM de Caractère. S'ajoutent à la base de chaque seuil mental couvert.",
                  "examples": [
                    2
                  ]
                },
                "localisations": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "anxiete",
                      "impuissance",
                      "colere",
                      "tristesse",
                      "peur",
                      "culpabilite"
                    ],
                    "description": "Localisation émotionnelle. Caractéristique associée : anxiété CHA, impuissance CHA, colère LOG, tristesse PER, peur VOL, culpabilité DEX.",
                    "examples": [
                      "peur",
                      "colere"
                    ]
                  },
                  "description": "Localisations émotionnelles couvertes par le trait de caractère. Au moins une, pour la même raison que l'armure.",
                  "examples": [
                    [
                      "peur",
                      "anxiete"
                    ]
                  ]
                }
              },
              "required": [
                "trait",
                "points",
                "localisations"
              ],
              "additionalProperties": false
            },
            "bouclier": {
              "description": "Bouclier mental : la censure derrière laquelle le personnage se réfugie.",
              "type": "object",
              "properties": {
                "nom": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Nom du bouclier, tel qu'écrit sur la fiche.",
                  "examples": [
                    "Portière de voiture",
                    "Déni"
                  ]
                },
                "proprietes": {
                  "description": "Type de couvert (bouclier physique) ou de censure (bouclier mental).",
                  "examples": [
                    [
                      "Couvert partiel"
                    ]
                  ],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Une propriété, en un mot ou deux."
                  }
                }
              },
              "required": [
                "nom"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "solidite"
          ],
          "additionalProperties": false,
          "description": "Protections mentales : solidité, trait de caractère, bouclier."
        }
      },
      "additionalProperties": false
    },
    "zoneDeDetection": {
      "description": "Distance à laquelle la créature repère une proie.",
      "examples": [
        "20 m"
      ],
      "type": "string",
      "minLength": 1
    },
    "deplacement": {
      "description": "Distance parcourue par action.",
      "examples": [
        "5 m par action"
