{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "minLength": 1,
      "description": "Nom de la créature. Champ local et non bloc identité : elle n'a ni nationalité ni signes particuliers.",
      "examples": [
        "Zé lent",
        "Traqueur"
      ]
    },
    "typeDeCorps": {
      "description": "Corps servant de base à la créature. Chaîne libre : le catalogue des corps appartient à chaque jeu.",
      "examples": [
        "Corps humain adulte"
      ],
      "type": "string",
      "minLength": 1
    },
    "instinct": {
      "description": "Instinct qui gouverne son comportement. Chaîne libre : un meneur en ajoute.",
      "examples": [
        "Dévorer"
      ],
      "type": "string",
      "minLength": 1
    },
    "typeInfecte": {
      "description": "Type d'infecté, quand le jeu en distingue plusieurs. Chaîne libre.",
      "examples": [
        "Type 1"
      ],
      "type": "string",
      "minLength": 1
    },
    "description": {
      "description": "Ce qu'on perçoit de la créature au premier regard.",
      "type": "string",
      "minLength": 1
    },
    "niveauDeDanger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "ND, imprimé en en-tête de fiche. Mesure l'opposition représentée. Sur une créature, il s'obtient en additionnant les ND du corps, de l'instinct et du type ; il n'est donc pas borné par le 5 de chaque composant.",
      "examples": [
        1,
        3,
        8
      ]
    },
    "caracteristiques": {
      "type": "object",
      "properties": {
        "for": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Force. Pourcentage de d100.",
          "examples": [
            40
          ]
        },
        "con": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Constitution. Pourcentage de d100.",
          "examples": [
            50
          ]
        },
        "dex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Dextérité. Pourcentage de d100.",
          "examples": [
            45
          ]
        },
        "rap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Rapidité. Pourcentage de d100.",
          "examples": [
            35
          ]
        },
        "log": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Logique. Pourcentage de d100.",
          "examples": [
            30
          ]
        },
        "vol": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Volonté. Pourcentage de d100.",
          "examples": [
            40
          ]
        },
        "per": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Perception. Pourcentage de d100.",
          "examples": [
            50
          ]
        },
        "cha": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Charisme. Pourcentage de d100.",
          "examples": [
            25
          ]
        }
      },
      "required": [
        "for",
        "con",
        "dex",
        "rap"
      ],
      "additionalProperties": false,
      "description": "Caractéristiques d'une créature : les quatre physiques toujours, les mentales seulement si elle en a. Un corps d'infecté ne porte souvent que PER."
    },
    "sante": {
      "description": "Seuils de dégât. Les mentaux n'ont de sens que si la créature a des caractéristiques mentales.",
      "type": "object",
      "properties": {
        "physique": {
          "type": "object",
          "properties": {
            "superficiel": {
              "type": "object",
              "properties": {
                "base": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Valeur du seuil sur une localisation non couverte.",
                  "examples": [
                    7,
                    16
                  ]
                },
                "couvert": {
                  "description": "Valeur du seuil sur une localisation couverte par une armure ou un trait de caractère. Vaut la base augmentée des points de protection.",
                  "examples": [
                    9,
                    18
                  ],
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "base"
              ],
              "additionalProperties": false,
              "description": "Seuil de dégât superficiel, le moins élevé des quatre."
            },
            "leger": {
              "type": "object",
              "properties": {
                "base": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Valeur du seuil sur une localisation non couverte.",
                  "examples": [
                    7,
                    16
                  ]
                },
                "couvert": {
                  "description": "Valeur du seuil sur une localisation couverte par une armure ou un trait de caractère. Vaut la base augmentée des points de protection.",
                  "examples": [
                    9,
                    18
                  ],
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "base"
              ],
              "additionalProperties": false,
              "description": "Seuil de dégât léger."
            },
            "grave": {
              "type": "object",
              "properties": {
                "base": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Valeur du seuil sur une localisation non couverte.",
                  "examples": [
                    7,
                    16
                  ]
                },
                "couvert": {
                  "description": "Valeur du seuil sur une localisation couverte par une armure ou un trait de caractère. Vaut la base augmentée des points de protection.",
                  "examples": [
                    9,
                    18
                  ],
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "base"
              ],
              "additionalProperties": false,
              "description": "Seuil de dégât grave."
            },
            "profond": {
              "type": "object",
              "properties": {
                "base": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Valeur du seuil sur une localisation non couverte.",
                  "examples": [
                    7,
                    16
                  ]
                },
                "couvert": {
                  "description": "Valeur du seuil sur une localisation couverte par une armure ou un trait de caractère. Vaut la base augmentée des points de protection.",
                  "examples": [
                    9,
                    18
                  ],
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "base"
              ],
              "additionalProperties": false,
              "description": "Seuil de dégât profond, le plus élevé des quatre."
            }
          },
          "required": [
            "superficiel",
            "leger",
            "grave",
            "profond"
          ],
          "additionalProperties": false,
          "description": "Seuils physiques : superficiel, léger, grave, profond. Stockés tels que lus sur la feuille, jamais recalculés — deux fiches publiées s'écartent d'un point de la dérivation."
        },
        "mental": {
          "description": "Seuils mentaux. Optionnels, et chacun d'eux facultatif : une créature sans caractéristiques mentales est insensible aux attaques mentales et n'en porte aucun.",
          "type": "object",
          "properties": {
