              ]
            },
            "rap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200,
              "description": "Rapidité. Pourcentage de d100.",
              "examples": [
                35
              ]
            },
            "log": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200,
              "description": "Logique. Pourcentage de d100.",
              "examples": [
                30
              ]
            },
            "vol": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200,
              "description": "Volonté. Pourcentage de d100.",
              "examples": [
                40
              ]
            },
            "per": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200,
              "description": "Perception. Pourcentage de d100.",
              "examples": [
                50
              ]
            },
            "cha": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200,
              "description": "Charisme. Pourcentage de d100.",
              "examples": [
                25
              ]
            }
          },
          "additionalProperties": false
        },
        "zoneDeDetection": {
          "description": "Distance de détection dans cet état, si elle change.",
          "type": "string",
          "minLength": 1
        },
        "deplacement": {
          "description": "Distance parcourue par action dans cet état, si elle change.",
          "type": "string",
          "minLength": 1
        },
        "actionsParRound": {
          "description": "Nombre d'actions par round dans cet état, s'il change.",
          "examples": [
            2
          ],
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "notes": {
          "description": "Ce que l'état change en plus des valeurs chiffrées.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "nom"
      ],
      "additionalProperties": false
    },
    "comportement": {
      "description": "Comment la créature agit, un trait par entrée.",
      "examples": [
        [
          "Suit le bruit",
          "N'escalade pas"
        ]
      ],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Un trait de comportement."
      }
    },
    "traitsSpeciaux": {
      "description": "Insensibilités, immunités, capacités hors du commun. Liste non bornée.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Un trait spécial."
      }
    },
    "competences": {
      "description": "Compétences rattachées directement à la créature : elle ne passe par aucune formation.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nom": {
            "type": "string",
            "minLength": 1,
            "description": "Nom de la compétence. Chaîne libre : le catalogue appartient à chaque jeu.",
            "examples": [
              "Arme sociale",
              "Athlétisme"
            ]
          },
          "specialite": {
            "description": "Spécialité, notée entre parenthèses après le nom sur la fiche.",
            "examples": [
              "Négociation"
            ],
            "type": "string",
            "minLength": 1
          },
          "pourcentage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200,
            "description": "Pourcentage de la compétence seule, hors caractéristique.",
            "examples": [
              30
            ]
          },
          "caracteristique": {
            "description": "Caractéristique qui s'ajoute au pourcentage. Notée sur la fiche de PNJ, laissée au jet sur la feuille de PJ.",
            "examples": [
              "cha"
            ],
            "type": "string",
            "enum": [
              "for",
              "con",
              "dex",
              "rap",
              "log",
              "vol",
              "per",
              "cha"
            ]
          },
          "total": {
            "description": "Pourcentage testé, compétence plus caractéristique. Pré-calculé sur la fiche de PNJ ; se recalcule à tout instant. Le schéma ne vérifie pas la somme — la caractéristique vit dans un autre bloc et draft-7 ne sait pas exprimer cette dépendance : un consommateur doit recalculer la valeur plutôt que la croire.",
            "examples": [
              50
            ],
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "avantages": {
            "description": "Avantages rattachés à cette compétence, notés sous elle sur la fiche : gestion du stress, bouclier personnel, équipement favori.",
            "examples": [
              [
                "Gestion du stress"
              ]
            ],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Un avantage, en une ligne."
            }
          }
        },
        "required": [
          "nom",
          "pourcentage"
        ],
        "additionalProperties": false,
        "description": "Une compétence de la fiche, avec sa spécialité et son total éventuel."
      }
    },
    "equipement": {
      "description": "Ce dont la créature se sert, quand elle se sert de quelque chose.",
      "type": "object",
      "properties": {
        "possessions": {
          "description": "Ce que le personnage transporte ou possède. Liste non bornée.",
          "examples": [
            [
              "Trousse de secours",
              "Lampe torche"
            ]
          ],
