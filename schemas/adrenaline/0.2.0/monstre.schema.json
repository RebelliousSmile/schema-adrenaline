                }
              },
              "required": [
                "base"
              ],
              "additionalProperties": false,
              "description": "Seuil de dégât superficiel, le moins élevé des quatre."
            },
            "leger": {
              "type": "object",
              "properties": {
                "base": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Valeur du seuil sur une localisation non couverte.",
                  "examples": [
                    7,
