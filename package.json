{
  "name": "schema-adrenaline",
  "version": "0.0.1",
  "description": "Open, versioned data schemas for the Adrenaline System (Zombiology and friends), to make digital tools interoperable.",
  "scripts": {
    "gen": "tsx tools/gen-schemas.ts",
    "validate": "tsx tools/validate-examples.ts",
    "audit": "tsx tools/audit-schemas.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run gen && npm run validate && npm run audit",
    "toml:one": "tsx tools/toml2json.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RebelliousSmile/schema-adrenaline.git"
  },
  "keywords": [
    "Adrenaline System",
    "Zombiology",
    "d100",
    "Schema",
    "Interoperable"
  ],
  "author": "RebelliousSmile",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RebelliousSmile/schema-adrenaline/issues"
  },
  "homepage": "https://github.com/RebelliousSmile/schema-adrenaline#readme",
  "type": "module",
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/node": "^24.5.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "zod": "^4.1.11"
  }
}
